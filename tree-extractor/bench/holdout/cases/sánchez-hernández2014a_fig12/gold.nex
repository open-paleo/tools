#NEXUS

[ sánchez-hernández2014a_fig12: Ceratosaur strict consensus, panel B: a 19-way polytomy from Camarillasaurus to Majungasaurus. CERATOSAURIA is printed under the stem that enters the fan, but panel A of the same figure prints it at the node that also holds Limusaurus, so the figure does not fix which node it names and it is not encoded. The numbers are bootstrap values. 23 tips, 1 polytomies (19 children). Sample 5 case (census 2, seed 20261215). Topology transcribed from the figure image and checked node by node; topology only. ]

BEGIN TAXA;
    DIMENSIONS NTAX=23;
    TAXLABELS
        Herrerasaurus
        Syntarsus
        Allosaurus
        Limusaurus
        Camarillasaurus
        Deltadromeus
        Spinostropheus
        Elaphrosaurus
        Ceratosaurus
        Genusaurus
        Laevisuchus
        Masiakasaurus
        Noasaurus
        Velocisaurus
        Rugops
        Ekrixinatosaurus
        Ilokelesia
        Aucasaurus
        Carnotaurus
        Abelisaurus
        Rajasaurus
        Indosaurus
        Majungasaurus
    ;
END;

BEGIN TREES;
    TREE 'sánchez-hernández2014a_fig12' = [&R] (Herrerasaurus,(Syntarsus,(Allosaurus,(Limusaurus,(Camarillasaurus,Deltadromeus,Spinostropheus,Elaphrosaurus,Ceratosaurus,Genusaurus,Laevisuchus,Masiakasaurus,Noasaurus,Velocisaurus,Rugops,Ekrixinatosaurus,Ilokelesia,Aucasaurus,Carnotaurus,Abelisaurus,Rajasaurus,Indosaurus,Majungasaurus)))));
END;
