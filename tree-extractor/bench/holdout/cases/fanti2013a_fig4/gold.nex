    TAXLABELS
        Flagellicaudata
        Amazonsaurus
        Histriasaurus
        Zapalasaurus
        Comahesaurus
        Rayosaurus
        Rebbachisaurus
        Cathartesaura
        Limaysaurus
        Nigersaurus
        Demandasaurus
        Tataouinea
    ;
END;

BEGIN TREES;
    TREE fanti2013a_fig4 = [&R] (Flagellicaudata,(Amazonsaurus,(Histriasaurus,Zapalasaurus,(Comahesaurus,((Rayosaurus,Rebbachisaurus,(Cathartesaura,Limaysaurus)),(Nigersaurus,(Demandasaurus,Tataouinea))))))Rebbachisauridae);
