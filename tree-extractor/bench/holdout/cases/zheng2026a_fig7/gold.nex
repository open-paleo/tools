        Sinotyrannus_kazuoensis
        Dilong_paradoxus
        Eotyrannus_lengi
        Aviatyrannis_jurassica
        Juratyrant_langhami
        Stokesosaurus_clevelandi
        Tanycolagreus_topwilsoni
    ;
END;

BEGIN TREES;
    TREE zheng2026a_fig7 = [&R] ((Kileskus_aristotocus,Proceratosaurus_bradleyi,Guanlong_wucaii,Yutyrannus_huali,Sinotyrannus_kazuoensis)Proceratosauridae,(Dilong_paradoxus,(Eotyrannus_lengi,(Aviatyrannis_jurassica,Juratyrant_langhami,Stokesosaurus_clevelandi,Tanycolagreus_topwilsoni)Stokesosauridae))Pantyrannosauria)Tyrannosauroidea;
