END;

BEGIN TREES;
    TREE godefroit2013b_fig3 = [&R] ((Epidendrosaurus,Epidexipteryx),(Eosinopteryx,(Dromaeosauridae,((Jinfengopteryx,(Mei,(Sinovenator,(Sinusonasus,(Byronosaurus,(Sinornithoides,(Saurornithoides,Troodon,Zanabazar)))))))Troodontidae,(Aurornis,(Anchiornis,(Archaeopteryx,(Xiaotingia,((Rahonavis,Shenzouraptor),(Balaur,(Sapeornis,(Confuciusornis,(Enantiornithes,Euornithes)))))))))Avialae))Eumaniraptora))Paraves;
