        Futalongkosaurus_dukei
        Puertasaurus_reuili
        Drusilasaura_deseadensis
        Argentinosaurus_huinculensis
        Patagotitan_mayorum
    ;
END;

BEGIN TREES;
    TREE 'agnolín2023a_fig11' = [&R] (Other_Titanosauria,((Rinconsaurus_caudamirus,(Muyelensaurus_pecheni,(Overosaurus_paradasorum,Arrudatitan_maximus)))Rin,(Bonitasaura_salgadoi,(Chucarosaurus_diripienda,(Notocolosus_gonzalesparejasi,(Mendozasaurus_neguyelap,((Quetecsaurus_rusconii,Futalongkosaurus_dukei),(Puertasaurus_reuili,Drusilasaura_deseadensis,(Argentinosaurus_huinculensis,Patagotitan_mayorum))))Longkosauria))))Colossosauria)Titanosauria;
