    ;
END;

BEGIN TREES;
    TREE meso2024a_fig7 = [&R] (Shishugounykus,(Aorun,(Haplocheirus,((Bannykus,(Xiyunykus,Tugulusaurus)),(Alnashetri,(((Bonapartenykus,Patagonykus),(Achillesaurus,Alvarezsaurus)),(Ceratonykus,(Khulsanurus,(Qiupanykus,(Dzharaonyx,((Linhenykus,Parvicursor),(Shuvuuia,(Mononykus,(Kol,(Ondogurvel,Albinykus,Xixianykus)))))))))))))));
