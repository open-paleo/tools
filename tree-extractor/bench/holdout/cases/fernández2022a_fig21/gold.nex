END;

BEGIN TREES;
    TREE 'fernández2022a_fig21' = [&R] (Pantydraco,(Thecodontosaurus,(Efraasia,(Ruehleia,(('''Sellosaurus''',Plateosaurus),(Riojasaurus,((Lufengosaurus,Massospondylus),(Anchisaurus,(Lessemsaurus,((Meroktenos,Tuebingosaurus),Volkheimeria))))))))));
END;
