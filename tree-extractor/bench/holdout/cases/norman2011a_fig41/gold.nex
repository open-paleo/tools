    DIMENSIONS NTAX=14;
    TAXLABELS
        Euparkeria
        Herrerasaurus
        Abrictosaurus
        Heterodontosaurus
        BMNH_A100
        Lesothosaurus
        Emausaurus
        Scelidosaurus
        Agilisaurus
