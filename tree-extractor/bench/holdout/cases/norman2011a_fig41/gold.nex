END;

BEGIN TREES;
    TREE norman2011a_fig41 = [&R] (Euparkeria,(Herrerasaurus,((Abrictosaurus,(Heterodontosaurus,BMNH_A100)),((Lesothosaurus,(Emausaurus,Scelidosaurus)),(Agilisaurus,(Hexinlusaurus,((Hypsilophodon,Pachycephalosauridae),(Ankylopollexia,Psittacosauridae))))))));
