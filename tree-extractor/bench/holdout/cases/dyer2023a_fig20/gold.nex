        Sinocephale_bexelli
        Pachycephalosaurus_wyomingensis
        Sphaerotholus_goodwini
        Acrotholus_audeti
        Prenocephale_prenes
    ;
END;

BEGIN TREES;
    TREE dyer2023a_fig20 = [&R] (Psittacosaurus_mongoliensis,(Yinlong_downsi,(Wannanosaurus_yansiensis,Colepiocephale_lambei,Stegoceras_validum,(Goyocephale_lattimorei,Homalocephale_calathocercos,Tylocephale_gilmorei,Foraminacephale_brevis,Alaskacephale_gangloffi,Sphaerotholus_buchholtzae,Sphaerotholus_edmontonensis,Amtocephale_gobienses,Sinocephale_bexelli,(Pachycephalosaurus_wyomingensis,Sphaerotholus_goodwini,(Acrotholus_audeti,Prenocephale_prenes))))));
