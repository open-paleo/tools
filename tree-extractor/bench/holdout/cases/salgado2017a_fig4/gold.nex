    TREE salgado2017a_fig4 = [&R] (Pisanosaurus_mertii,(Eocursor_parvus,Scutellosaurus_lawleri,Laquintasaura_venezuelae,Stormbergia_dangershoeki,Lesothosaurus_diagnosticus,Heterodontosauridae,(Emausaurus_ernstii,(Scelidosaurus_harrisonii,(Ankylosauria,Stegosauria)))Thyreophora,(Agilisaurus_louderbacki,(Hexinlusaurus_multidens,(Isaberrysaura_mollensis,Kulindadromeus_zabaikalicus,(Hypsilophodon_foxii,Yandusaurus_hongheensis,Othnieliosaurus_consors,Jeholosaurus_shangyuanensis,Zephyrosaurus_schaffi,Changchunsaurus_parvus,Haya_griva,Orodromeus_makelai,Thescelosaurus_neglectus,(Marginocephalia,(Talenkauen_santacrucensis,(Parksosaurus_warreni,Gasparinisaura_cincosaltensis),Iguanodontia))))Ornithopoda))Neornithischia))Ornithischia;
