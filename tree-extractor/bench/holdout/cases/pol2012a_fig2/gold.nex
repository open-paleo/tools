        Abelisaurus
        Majungasaurus
        Indosaurus
        Rajasaurus
        Skorpiovenator
        Ilokelesia
        Ekrixinatosaurus
        Carnotaurus
        Aucasaurus
    ;
END;

BEGIN TREES;
    TREE pol2012a_fig2 = [&R] (Syntarsus,(Allosaurus,(Deltadromeus,Berberosaurus,((Spinostropheus,(Limusaurus,Elaphrosaurus)),((Ceratosaurus,Genyodectes),((Velocisaurus,Noasaurus,Masiakasaurus,Laevisuchus)Noasauridae,(Eoabelisaurus,(Rugops,(Abelisaurus,((Majungasaurus,Indosaurus,Rajasaurus),((Skorpiovenator,Ilokelesia,Ekrixinatosaurus),(Carnotaurus,Aucasaurus))Brachyrostra))))Abelisauridae)Abelisauroidea)))Ceratosauria));
