        Hudiesaurus_sinojapanorum
        Chuanjiesaurus_referred
        Chuanjiesaurus_holotype
        Wamweracaudia
        Mamenchisaurus_hochuanensis_referred
        Mamenchisaurus_hochuanensis_holotype
        Mamenchisaurus_youngi
        Mamenchisaurus_sinocanadorum
        Klamelisaurus_gobiensis
        Qijianglong_guokr
        Shishugou_cervicodorsals
        Phu_Kradung_taxa
        Mamenchisaurus_constructus
        Other_eusauropods
    ;
END;

BEGIN TREES;
    TREE zhang2022a_fig16 = [&R] (Shunosaurus,(Omeisaurus_maoianus,Haute_Mouloya_taxon,(Cetiosaurus_oxoniensis,(((Cetiosauriscus_stewarti,Omeisaurus_tianfuensis),(Tienshanosaurus_chitaiensis,(Omeisaurus_junghiensis,(Xinjiangtitan_shanshanesis,Rhomaleopakhus,Hudiesaurus_sinojapanorum,Chuanjiesaurus_referred,Chuanjiesaurus_holotype,Wamweracaudia,Mamenchisaurus_hochuanensis_referred,Mamenchisaurus_hochuanensis_holotype,Mamenchisaurus_youngi,Mamenchisaurus_sinocanadorum,Klamelisaurus_gobiensis,Qijianglong_guokr,Shishugou_cervicodorsals,Phu_Kradung_taxa,Mamenchisaurus_constructus)))),Other_eusauropods))));
