        Condorraptor
        Spinosauroidea
        Monolophosaurus
        Allosauroidea
        Tyrannosauroidea
        'Coeluridae + Comspognathidae'
        Ornithomimidae
        Ornitholestes
        Paraves
    ;
END;

BEGIN TREES;
    TREE averianov2010a_fig9 = [&R] (Prosauropoda,(Coelophysidae,(Zupayasaurus,('“Dilophosauridae”',('Ceratosauridae + Abelisauridae',((Piatnitzkysaurus,Condorraptor),(Spinosauroidea,(Monolophosaurus,(Allosauroidea,(Tyrannosauroidea,('Coeluridae + Comspognathidae',(Ornithomimidae,(Ornitholestes,Paraves)Maniraptora)))Coelurosauria))))Tetanurae)))));
