END;

BEGIN TREES;
    TREE senter2012b_fig12 = [&R] (Tyrannosauridae,(Compsognathidae,(Ornithomimosauria,(Therizinosauroidea,(Oviraptorosauria,(Avialae,(Troodontidae,(Unenlagiinae,(Microraptoria,(Bambiraptor,(Velociraptorinae,(Deinonychus,(Achillobator,Utahraptor,Yurgovuchia))))Eudromaeosauria))Dromaeosauridae)Deinonychosauria)Paraves)))))Coelurosauria;
