        Coelurus_fragilis
        Dilong_paradoxus
        Eotyrannus_lengi
        Tyrannosaurus_rex
        Gorgosaurus_libratus
        Zuolong_salleei
        Mirischia_asymmetrica
        Huaxiagnathus_orientalis
        Compsognathus_longipes
        Sinosauropteryx_prima
        Juravenator_starki
        Nqwebasaurus_thwazi
        Aniksosaurus_darwini
        Ornithomimosauria
        Ornitholestes_hermanni
        Therizinosauria
        Oviraptorosauria
        Alvarezsauridae
        Dromaeosauridae
        Troodontidae
        Scansoriopterygidae
        Aves
    ;
END;

BEGIN TREES;
    TREE novas2012a_fig7 = [&R] (Piatnitzkysaurus_floresi,(Mapusaurus_roseae,(Allosaurus_fragilis,Sinraptor_dongi))Allo.,(Tugulusaurus_faciles,(Bicentenaria_argentina,(((Tanycolagreus_topwilsoni,Coelurus_fragilis),(Dilong_paradoxus,(Eotyrannus_lengi,(Tyrannosaurus_rex,Gorgosaurus_libratus))))Tyrann.,(Zuolong_salleei,((Mirischia_asymmetrica,Huaxiagnathus_orientalis,Compsognathus_longipes,Sinosauropteryx_prima,Juravenator_starki,Nqwebasaurus_thwazi)Comps.,(Aniksosaurus_darwini,(Ornithomimosauria,(Ornitholestes_hermanni,(Therizinosauria,Oviraptorosauria,Alvarezsauridae,((Dromaeosauridae,Troodontidae),(Scansoriopterygidae,Aves))))Mani.)))))))COELUROSAURIA);
END;
