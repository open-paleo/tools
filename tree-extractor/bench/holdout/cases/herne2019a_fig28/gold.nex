    ;
END;

BEGIN TREES;
    TREE herne2019a_fig28 = [&R] (((Talenkauen,((Macrogryphosaurus,Gasparinisaura),(Anabisetia,Diluvicursor,Leaellynasaura,Galleonosaurus)))Elasmaria,(((Muttaburrasaurus,(((Dryosauridae,Owenodon),(Camptosaurus,Styracosterna)),Tenontosaurus)),Rhabdodontidae),Hypsilophodon)),Parksosaurus)Ornithopoda;
